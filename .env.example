# PostgreSQL — use a SEPARATE database for gamify (e.g. .../gamify), never another project's database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gamify?schema=public"

# Root domain: tenants live on <slug>.ROOT_DOMAIN. In dev use localhost:3000 (najot.localhost:3000 works in browsers).
ROOT_DOMAIN="localhost:3000"   # production: zukkolar.uz
DEFAULT_TENANT_SLUG="gamify"

# Feature flags (see PLAN.md §3.5)
FEATURE_SMS_OTP="false"
FEATURE_REDIS="false"

# Where uploaded pictures are stored (served at /media/…). Default: ./.media. Production: /srv/zukkolar/shared/media
# MEDIA_DIR=""

# Local dev only: shadow DB for `prisma migrate dev` (prisma dev prints it)
# SHADOW_DATABASE_URL=""
# Max DB connections per app instance (default 10). Use 1 with local `prisma dev`.
# DATABASE_POOL_MAX=""
