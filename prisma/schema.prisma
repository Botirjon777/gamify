generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

enum TenantPlan {
  FREE
  STANDARD
  PRO
}

/// A study center (or the public platform itself, slug = "gamify").
model Tenant {
  id        String     @id @default(cuid())
  slug      String     @unique /// najot → najot.gamify.uz
  name      String
  logoUrl   String?
  theme     Json? /// { primary: "#…", … }
  plan      TenantPlan @default(FREE)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  domains     TenantDomain[]
  memberships Membership[]
  sessions    Session[]
  xpEvents    XpEvent[]
  weeklyScores WeeklyScore[]
}

/// Custom domains, e.g. learn.najot.uz (later).
model TenantDomain {
  id       String @id @default(cuid())
  domain   String @unique
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum Role {
  OWNER
  ADMIN
  TEACHER
  STUDENT
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
}

// ─── Users & auth ───────────────────────────────────────────────────────────

/// Users are global; they join tenants through Membership.
model User {
  id                 String    @id @default(cuid())
  phone              String    @unique /// E.164, +998XXXXXXXXX
  phoneVerified      Boolean   @default(false) /// stays false until SMS OTP is enabled
  username           String    @unique /// stored lowercase
  passwordHash       String
  mustChangePassword Boolean   @default(false) /// set after an admin password reset
  isSuperAdmin       Boolean   @default(false)
  avatarSeed         String
  avatarConfig       Json?
  locale             String    @default("uz")
  timezone           String    @default("Asia/Tashkent")

  xp            Int       @default(0)
  level         Int       @default(1)
  iqRating      Float     @default(1000)
  iqDeviation   Float     @default(350)
  /// Set when the placement IQ test is finished; null → user is sent to the test first.
  iqTestedAt    DateTime?
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveDay DateTime? @db.Date
  streakFreezes Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  sessions     Session[]
  xpEvents     XpEvent[]
  dailyClaims  DailyClaim[]
  weeklyScores WeeklyScore[]
  attempts     Attempt[]
  masteries    SkillMastery[]
  iqSessions   IqSession[]

  @@index([xp(sort: Desc)])
  @@index([iqRating(sort: Desc)])
}

/// DB-backed session = one logged-in device. Only the SHA-256 of the token is stored.
model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  tenantId     String
  userAgent    String?
  deviceName   String? /// "Chrome · Windows"
  ip           String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// ─── Learning content (synced from /content by `pnpm content:sync`) ────────

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// e.g. React. `tenantId = null` → global content made by us.
model Track {
  id          String        @id @default(cuid())
  slug        String        @unique
  tenantId    String?
  title       Json /// { "uz": "..." }
  description Json?
  icon        String?
  order       Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  modules     Module[]
}

/// e.g. React → "State"
model Module {
  id      String  @id @default(cuid())
  trackId String
  slug    String
  title   Json
  order   Int     @default(0)
  track   Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  skills  Skill[]

  @@unique([trackId, slug])
}

/// The unit you drill, e.g. "useState". Slugs are globally unique → /learn/react/use-state
model Skill {
  id          String         @id @default(cuid())
  moduleId    String
  slug        String         @unique
  title       Json
  description Json?
  order       Int            @default(0)
  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  masteries   SkillMastery[]
}

enum ExerciseType {
  CHOICE /// pick one option
  OUTPUT /// predict what the code prints / renders
  FILL /// fill the ___ blanks in code
  ORDER /// put code lines in the right order
}

model Exercise {
  id          String        @id @default(cuid())
  key         String        @unique /// stable id from the content file, e.g. "use-state-001"
  skillId     String
  tenantId    String?
  type        ExerciseType
  difficulty  Int           @default(1) /// 1 easy · 2 medium · 3 hard
  xp          Int
  content     Json /// public part, safe to send to the browser
  answer      Json /// private — never sent before the user answers
  explanation Json?
  order       Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  updatedAt   DateTime      @updatedAt

  skill    Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([skillId, status])
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String
  exerciseId String
  correct    Boolean
  answer     Json
  timeMs     Int?
  xpAwarded  Int      @default(0)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId])
  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
}

/// Per user per skill, 0–100. Global (a skill mastered is mastered on every tenant).
model SkillMastery {
  userId          String
  skillId         String
  score           Float    @default(0)
  attempts        Int      @default(0)
  correct         Int      @default(0)
  lastPracticedAt DateTime @default(now())
  nextReviewAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([userId, nextReviewAt])
}

// ─── IQ tests (items synced from /content/iq) ───────────────────────────────

/// One IQ question. `rating` starts from difficulty and self-calibrates (Elo) as people answer.
model IqItem {
  id            String        @id @default(cuid())
  key           String        @unique
  category      String /// sequence, letters, shapes, analogy, odd, logic, math
  difficulty    Int /// 1–5 (initial rating only)
  rating        Float
  content       Json /// public: { prompt, figure?, options }
  answer        Int /// private: index of the correct option
  status        ContentStatus @default(PUBLISHED)
  timesAnswered Int           @default(0)
  timesCorrect  Int           @default(0)
  attempts      IqAttempt[]
}

enum IqSessionKind {
  PLACEMENT /// first test after registration
  DAILY
}

enum IqSessionStatus {
  ACTIVE
  FINISHED
}

model IqSession {
  id             String          @id @default(cuid())
  userId         String
  tenantId       String
  kind           IqSessionKind
  status         IqSessionStatus @default(ACTIVE)
  total          Int
  answered       Int             @default(0)
  correct        Int             @default(0)
  /// The question on screen right now; its deadline is enforced on the server.
  currentItemId  String?
  currentShownAt DateTime?
  ratingBefore   Float
  ratingAfter    Float?
  xpAwarded      Int             @default(0)
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts IqAttempt[]

  @@index([userId, kind, status])
}

model IqAttempt {
  id           String   @id @default(cuid())
  sessionId    String
  userId       String
  itemId       String
  choice       Int? /// null = time ran out
  correct      Boolean
  timeMs       Int
  ratingBefore Float
  ratingAfter  Float
  createdAt    DateTime @default(now())

  session IqSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    IqItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, itemId])
}

// ─── Gamification ───────────────────────────────────────────────────────────

enum XpReason {
  LOGIN_BONUS
  STREAK_BONUS
  EXERCISE
  DAILY_QUIZ
  DAILY_PROBLEM
  IQ_TEST
  ADMIN_ADJUST
}

/// The only way XP changes. User.xp is a cached sum, updated in the same transaction.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  amount    Int
  reason    XpReason
  refId     String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
}

enum DailyKind {
  LOGIN
  QUIZ
  PROBLEM
  IQ
}

model DailyClaim {
  userId    String
  day       DateTime  @db.Date /// Asia/Tashkent calendar day
  kind      DailyKind
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, kind])
}

enum Board {
  XP
  IQ
}

/// Weekly leaderboard rows; `week` is the Monday (Asia/Tashkent) the week starts on.
model WeeklyScore {
  userId   String
  tenantId String
  week     DateTime @db.Date
  board    Board
  value    Float    @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId, week, board])
  @@index([tenantId, week, board, value(sort: Desc)])
}

// ─── Deferred infrastructure (tables exist, features switched off) ─────────

enum OtpPurpose {
  VERIFY_PHONE
  RESET_PASSWORD
}

model OtpCode {
  id        String     @id @default(cuid())
  phone     String
  codeHash  String
  purpose   OtpPurpose
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

/// Fixed-window rate limiting (Postgres implementation; Redis later).
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}
