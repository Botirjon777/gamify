generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

enum TenantPlan {
  FREE
  STANDARD
  PRO
}

/// A study center (or the public platform itself, slug = "gamify").
model Tenant {
  id        String     @id @default(cuid())
  slug      String     @unique /// najot → najot.gamify.uz
  name      String
  logoUrl   String?
  theme     Json? /// { primary: "#…", … }
  plan      TenantPlan @default(FREE)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  domains      TenantDomain[]
  memberships  Membership[]
  sessions     Session[]
  xpEvents     XpEvent[]
  weeklyScores WeeklyScore[]
  seasonScores SeasonScore[]
}

/// Custom domains, e.g. learn.najot.uz (later).
model TenantDomain {
  id       String @id @default(cuid())
  domain   String @unique
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum Role {
  OWNER
  ADMIN
  TEACHER
  STUDENT
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
}

// ─── Users & auth ───────────────────────────────────────────────────────────

/// Users are global; they join tenants through Membership.
model User {
  id                 String    @id @default(cuid())
  /// E.164, +998XXXXXXXXX. Optional so staff accounts (admin) can exist without one.
  phone              String?   @unique
  /// Optional login e-mail (admin / staff accounts), stored lowercase.
  email              String?   @unique
  phoneVerified      Boolean   @default(false) /// stays false until SMS OTP is enabled
  username           String    @unique /// stored lowercase
  passwordHash       String
  mustChangePassword Boolean   @default(false) /// set after an admin password reset
  isSuperAdmin       Boolean   @default(false)
  /// Blocked by an admin: cannot log in, all sessions revoked.
  blockedAt          DateTime?
  avatarSeed         String
  avatarConfig       Json?
  locale             String    @default("uz")
  timezone           String    @default("Asia/Tashkent")

  xp               Int       @default(0)
  level            Int       @default(1)
  iqRating         Float     @default(1000)
  iqDeviation      Float     @default(350)
  /// Set when the placement IQ test is finished (the test is optional).
  iqTestedAt       DateTime?
  /// User hid the "take the IQ test" invitation on the dashboard.
  iqPromptHiddenAt DateTime?

  /// Personal subscription (FREE grows slower: daily XP cap, no multiplier).
  plan          UserPlan  @default(FREE)
  planExpiresAt DateTime?

  /// Used to generate a fitting avatar (hair, facial hair, earrings). null = not set yet (older accounts).
  gender Gender?

  /// Avatar customization (unlocked at level 10); style = DiceBear style key.
  avatarStyle String  @default("adventurer")
  bio         String?

  /// Subjects the user chose to follow (onboarding / settings): shown on the profile, first on the learn page.
  interests      Subject[] @default([])
  /// null = never asked (the dashboard still offers the picker); set even when the user skipped.
  interestsSetAt DateTime?

  /// Invite code others can register with, e.g. "K7M2QX". Created on first use.
  referralCode       String?   @unique
  referredById       String?
  /// When the inviter got their reward (invitee reached the required level).
  referralRewardedAt DateTime?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  /// The partner who brought this user (their link, or their promo code on the first payment). Set once.
  partnerId          String?
  partnerAt          DateTime?
  partner            Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  referrals          User[]    @relation("Referrals")
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastActiveDay      DateTime? @db.Date
  streakFreezes      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  sessions      Session[]
  xpEvents      XpEvent[]
  dailyClaims   DailyClaim[]
  weeklyScores  WeeklyScore[]
  seasonScores  SeasonScore[]
  conversations ConversationMember[]
  messages      Message[]
  duelsSent     Duel[]               @relation("DuelChallenger")
  duelsReceived Duel[]               @relation("DuelOpponent")
  duelRuns      DuelRun[]
  attempts      Attempt[]
  masteries     SkillMastery[]
  iqSessions    IqSession[]

  sentFriendRequests     Friendship[]      @relation("FriendRequester")
  receivedFriendRequests Friendship[]      @relation("FriendAddressee")
  notifications          Notification[]
  badges                 UserBadge[]
  clanMembership         ClanMember?
  clanJoinRequests       ClanJoinRequest[]
  payments               Payment[]

  @@index([xp(sort: Desc)])
  @@index([iqRating(sort: Desc)])
  @@index([partnerId])
}

/// DB-backed session = one logged-in device. Only the SHA-256 of the token is stored.
model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  tenantId     String
  userAgent    String?
  deviceName   String? /// "Chrome · Windows"
  ip           String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// ─── Learning content (synced from /content by `pnpm content:sync`) ────────

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// e.g. React. `tenantId = null` → global content made by us.
model Track {
  id           String         @id @default(cuid())
  slug         String         @unique
  tenantId     String?
  title        Json /// { "uz": "..." }
  description  Json?
  icon         String?
  order        Int            @default(0)
  status       ContentStatus  @default(PUBLISHED)
  subject      Subject        @default(PROGRAMMING)
  /// Only for subjects that are split into categories (Programming); null = listed directly under the subject.
  category     TrackCategory?
  modules      Module[]
  weeklyTopics WeeklyTopic[]
  duels        Duel[]

  @@index([category, order])
}

/// Top level of the catalog and what users pick as interests. Empty subjects are shown as "coming soon".
enum Subject {
  PROGRAMMING
  MATH
  GEOMETRY
  PHYSICS
  CHEMISTRY
  BIOLOGY
  CHESS
}

/// Directions inside Programming. Empty categories are shown as "coming soon".
enum TrackCategory {
  FRONTEND
  BACKEND
  CYBERSECURITY
  LINUX
  NETWORKING
  BASIC
  MIX
}

/// The week's bonus topic: exercise XP in this track is doubled (WEEKLY_BONUS events).
/// Weeks without a row fall back to an automatic rotation over the published tracks.
model WeeklyTopic {
  week      DateTime @id @db.Date /// Monday (Tashkent)
  trackId   String
  setById   String?
  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

/// Seasons run 1–3 months; XP earned inside one is summed into SeasonScore for the season leaderboard.
model Season {
  id          String    @id @default(cuid())
  number      Int       @unique
  startsAt    DateTime
  endsAt      DateTime
  /// Set once final ranks were announced (lazy, first request after endsAt).
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())

  scores SeasonScore[]
}

model SeasonScore {
  userId   String
  tenantId String
  seasonId String
  value    Float  @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId, seasonId])
  @@index([tenantId, seasonId, value(sort: Desc)])
}

/// e.g. React → "State"
model Module {
  id      String  @id @default(cuid())
  trackId String
  slug    String
  title   Json
  order   Int     @default(0)
  track   Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  skills  Skill[]

  @@unique([trackId, slug])
}

/// The unit you drill, e.g. "useState". Slugs are globally unique → /learn/react/use-state
model Skill {
  id          String         @id @default(cuid())
  moduleId    String
  slug        String         @unique
  title       Json
  description Json?
  order       Int            @default(0)
  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  masteries   SkillMastery[]
}

enum ExerciseType {
  CHOICE /// pick one option
  OUTPUT /// predict what the code prints / renders
  FILL /// fill the ___ blanks in code
  ORDER /// put code lines in the right order
}

model Exercise {
  id          String        @id @default(cuid())
  key         String        @unique /// stable id from the content file, e.g. "use-state-001"
  skillId     String
  tenantId    String?
  type        ExerciseType
  difficulty  Int           @default(1) /// 1 easy · 2 medium · 3 hard
  xp          Int
  content     Json /// public part, safe to send to the browser
  answer      Json /// private — never sent before the user answers
  explanation Json?
  order       Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  updatedAt   DateTime      @updatedAt

  skill    Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([skillId, status])
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String
  exerciseId String
  correct    Boolean
  answer     Json
  timeMs     Int?
  xpAwarded  Int      @default(0)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId])
  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
}

/// Per user per skill, 0–100. Global (a skill mastered is mastered on every tenant).
model SkillMastery {
  userId          String
  skillId         String
  score           Float    @default(0)
  attempts        Int      @default(0)
  correct         Int      @default(0)
  lastPracticedAt DateTime @default(now())
  nextReviewAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([userId, nextReviewAt])
}

// ─── IQ tests (items synced from /content/iq) ───────────────────────────────

/// One IQ question. `rating` starts from difficulty and self-calibrates (Elo) as people answer.
model IqItem {
  id            String        @id @default(cuid())
  key           String        @unique
  category      String /// sequence, letters, shapes, analogy, odd, logic, math
  difficulty    Int /// 1–5 (initial rating only)
  rating        Float
  content       Json /// public: { prompt, figure?, options }
  answer        Int /// private: index of the correct option
  status        ContentStatus @default(PUBLISHED)
  timesAnswered Int           @default(0)
  timesCorrect  Int           @default(0)
  attempts      IqAttempt[]
}

enum IqSessionKind {
  PLACEMENT /// first test after registration
  DAILY
}

enum IqSessionStatus {
  ACTIVE
  FINISHED
}

model IqSession {
  id             String          @id @default(cuid())
  userId         String
  tenantId       String
  kind           IqSessionKind
  status         IqSessionStatus @default(ACTIVE)
  total          Int
  answered       Int             @default(0)
  correct        Int             @default(0)
  /// The question on screen right now; its deadline is enforced on the server.
  currentItemId  String?
  currentShownAt DateTime?
  ratingBefore   Float
  ratingAfter    Float?
  xpAwarded      Int             @default(0)
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts IqAttempt[]

  @@index([userId, kind, status])
}

model IqAttempt {
  id           String   @id @default(cuid())
  sessionId    String
  userId       String
  itemId       String
  choice       Int? /// null = time ran out
  correct      Boolean
  timeMs       Int
  ratingBefore Float
  ratingAfter  Float
  createdAt    DateTime @default(now())

  session IqSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    IqItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, itemId])
}

// ─── Gamification ───────────────────────────────────────────────────────────

enum XpReason {
  LOGIN_BONUS
  STREAK_BONUS
  EXERCISE
  DAILY_QUIZ
  DAILY_PROBLEM
  IQ_TEST
  ADMIN_ADJUST
  REFERRAL
  BADGE
  CLAN_REWARD
  DUEL
  WEEKLY_BONUS
  TRACK_COMPLETE
}

enum Gender {
  MALE
  FEMALE
}

enum UserPlan {
  FREE
  PRO
  DIAMOND
}

// ─── Social ─────────────────────────────────────────────────────────────────

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// One row per pair. requester → addressee; becomes ACCEPTED when the addressee accepts.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  CLAN_JOIN_REQUEST
  CLAN_JOIN_APPROVED
  CLAN_JOIN_REJECTED
  CLAN_WEEKLY_RESULT
  BADGE_EARNED
  LEVEL_UP
  REFERRAL_JOINED
  REFERRAL_REWARD
  PAYMENT_SUBMITTED /// to admins
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  TRACK_COMPLETED
  SEASON_RESULT
  DUEL_INVITE
  DUEL_DECLINED
  DUEL_RESULT
}

// ─── Payments & admin ───────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CARD_TRANSFER
  CLICK
  PAYME
  CASH
}

/// What a payment buys.
enum PaymentProduct {
  /// A subscription: `plan` for `months`.
  PLAN
  /// One-time: the printable IQ certificate (free with Pro / Diamond).
  IQ_CERTIFICATE
}

/// A purchase. Card transfers are checked and approved by an admin; approval activates the plan / unlocks the product.
model Payment {
  id           String         @id @default(cuid())
  userId       String
  product      PaymentProduct @default(PLAN)
  /// Only for PLAN payments.
  plan         UserPlan?
  /// Subscription length; 0 for one-time products.
  months       Int
  amountUzs    Int
  method       PaymentMethod  @default(CARD_TRANSFER)
  /// What the user entered to identify the transfer (payer card last digits, time, transaction id…)
  reference    String?
  status       PaymentStatus  @default(PENDING)
  adminNote    String?
  createdAt    DateTime       @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  /// Promo code used; `amountUzs` is already the discounted price, `discountUzs` what was taken off.
  promoCodeId  String?
  discountUzs  Int            @default(0)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([promoCodeId])
}

/// A discount code for buying a subscription, created by an admin. One use per user.
model PromoCode {
  id          String    @id @default(cuid())
  /// What the user types, stored uppercase: "YOZ25"
  code        String    @unique
  /// Discount in percent, 1–100.
  percent     Int
  /// Only for this plan; null = any paid plan.
  plan        UserPlan?
  /// How many payments may use it (pending + approved); null = unlimited.
  maxUses     Int?
  /// null = never expires.
  expiresAt   DateTime?
  /// Switched off by an admin: can't be used any more, history stays.
  active      Boolean   @default(true)
  note        String?
  /// A partner's own code: a user who pays with it is attributed to that partner.
  partnerId   String?
  createdById String?
  createdAt   DateTime  @default(now())

  payments Payment[]
  partner  Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
}

/// Someone who recommends Zukkolar (a blogger, a teacher, a channel). People who arrive through their link
/// (/p/<code>) or pay with their promo code are attributed to them, so we know what each partner brings.
model Partner {
  id        String   @id @default(cuid())
  /// In the link, lowercase: zukkolar.uz/p/aziz
  code      String   @unique
  name      String
  contact   String?
  note      String?
  /// Switched off: the link still opens the site but nobody new is attributed.
  active    Boolean  @default(true)
  /// How many times the link was opened.
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  users      User[]
  promoCodes PromoCode[]
  guestTests GuestIqTest[]
}

/// An IQ test taken without an account (/iq-test). The test is free; the result and the certificate are paid:
/// the person transfers the money, sends the receipt in Telegram together with `code`, an admin marks the test
/// paid, and /iq-test/<token> turns into the certificate.
model GuestIqTest {
  id             String          @id @default(cuid())
  /// In the URL. Unguessable: whoever has the link can open the (paid) certificate.
  token          String          @unique
  /// Short code the person tells us when paying — also their code in share links (/iq-test?r=<code>).
  code           String          @unique
  firstName      String
  lastName       String
  age            Int
  /// E.164, +998XXXXXXXXX
  phone          String
  status         IqSessionStatus @default(ACTIVE)
  total          Int
  answered       Int             @default(0)
  correct        Int             @default(0)
  /// Elo rating during the test (questions adapt to it); the score is derived from it.
  rating         Float           @default(1000)
  /// Questions already asked — never repeated within a test.
  askedItemIds   String[]
  /// The question on screen right now; its deadline is enforced on the server.
  currentItemId  String?
  currentShownAt DateTime?
  /// Final score, set when the test is finished.
  iq             Int?
  finishedAt     DateTime?
  /// Set by an admin once the transfer is confirmed.
  paidAt         DateTime?
  paidById       String?
  amountUzs      Int             @default(0)
  /// Came through a partner's link.
  partnerId      String?
  /// Came through another guest's share link.
  referredById   String?
  createdAt      DateTime        @default(now())

  partner    Partner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  referredBy GuestIqTest?  @relation("GuestIqReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  GuestIqTest[] @relation("GuestIqReferrals")

  @@index([status, paidAt, finishedAt])
  @@index([phone])
  @@index([partnerId])
  @@index([referredById])
}

/// Every admin action, for accountability.
model AdminAction {
  id           String   @id @default(cuid())
  adminId      String
  action       String /// e.g. "user.block", "payment.approve"
  targetUserId String?
  data         Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  /// Type-specific payload, e.g. { username, clanName, badge, level, xp }
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// Badge definitions live in code (features/badges/catalog.ts); this records who earned what.
model UserBadge {
  userId   String
  badge    String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badge])
}

// ─── Clans ──────────────────────────────────────────────────────────────────

enum ClanRole {
  LEADER
  OFFICER
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Clan {
  id          String   @id @default(cuid())
  tenantId    String
  slug        String   @unique
  name        String
  /// 2–5 uppercase letters shown next to members' names, e.g. [REACT]
  tag         String   @unique
  description String?
  /// Icon key (lucide) and gradient key chosen by the leader.
  emblem      String   @default("shield")
  color       String   @default("brand")
  createdAt   DateTime @default(now())

  members  ClanMember[]
  requests ClanJoinRequest[]
  results  ClanWeeklyResult[]
  chat     Conversation?

  @@index([tenantId])
}

model ClanMember {
  clanId   String
  /// A user can be in one clan at a time.
  userId   String   @unique
  role     ClanRole @default(MEMBER)
  joinedAt DateTime @default(now())

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clanId, userId])
}

/// Joining always needs approval from the clan leader or an officer.
model ClanJoinRequest {
  id          String            @id @default(cuid())
  clanId      String
  userId      String
  message     String?
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?
  decidedById String?

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clanId, userId])
  @@index([clanId, status])
}

/// Final standings of a finished week (written once, the first time anyone looks after the week ends).
model ClanWeeklyResult {
  id       String   @id @default(cuid())
  tenantId String
  week     DateTime @db.Date
  clanId   String
  rank     Int
  score    Float
  members  Int

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([week, clanId])
  @@index([tenantId, week, rank])
}

/// The only way XP changes. User.xp is a cached sum, updated in the same transaction.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  amount    Int
  reason    XpReason
  refId     String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
}

enum DailyKind {
  LOGIN
  QUIZ
  PROBLEM
  IQ
}

model DailyClaim {
  userId    String
  day       DateTime  @db.Date /// Asia/Tashkent calendar day
  kind      DailyKind
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, kind])
}

enum Board {
  XP
  IQ
}

/// Weekly leaderboard rows; `week` is the Monday (Asia/Tashkent) the week starts on.
model WeeklyScore {
  userId   String
  tenantId String
  week     DateTime @db.Date
  board    Board
  value    Float    @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId, week, board])
  @@index([tenantId, week, board, value(sort: Desc)])
}

// ─── Deferred infrastructure (tables exist, features switched off) ─────────

enum OtpPurpose {
  VERIFY_PHONE
  RESET_PASSWORD
}

model OtpCode {
  id        String     @id @default(cuid())
  phone     String
  codeHash  String
  purpose   OtpPurpose
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

/// Fixed-window rate limiting (Postgres implementation; Redis later).
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

// ─── Chat (not real-time: the open conversation polls) ─────────────────────

enum ConversationKind {
  DIRECT
  CLAN
}

/// DIRECT: two friends (pairKey = "<smaller id>:<larger id>"). CLAN: one per clan; who may read/write
/// is decided by ClanMember, ConversationMember only keeps the read position.
model Conversation {
  id            String           @id @default(cuid())
  kind          ConversationKind
  pairKey       String?          @unique
  clanId        String?          @unique
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())

  clan     Clan?                @relation(fields: [clanId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── 1v1 duels (turn-based: each player answers the same questions on their own time) ─────

enum DuelStatus {
  /// Challenger invited the opponent (and may already be playing).
  PENDING
  /// Opponent accepted.
  ACTIVE
  DONE
  DECLINED
  /// Nobody answered / finished in time (no XP moves when nobody finished).
  EXPIRED
}

model Duel {
  id           String     @id @default(cuid())
  tenantId     String
  challengerId String
  opponentId   String
  trackId      String
  /// XP the winner gets and the loser loses.
  stake        Int
  /// Exercise ids, same order for both players.
  questionIds  String[]
  status       DuelStatus @default(PENDING)
  /// null on a draw (or before the end).
  winnerId     String?
  createdAt    DateTime   @default(now())
  acceptedAt   DateTime?
  finishedAt   DateTime?
  /// Invite / play deadline; checked lazily.
  expiresAt    DateTime

  challenger User      @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User      @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  track      Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  runs       DuelRun[]

  @@index([challengerId, status])
  @@index([opponentId, status])
}

/// One player's attempt: started once, answered in order, finished once.
model DuelRun {
  duelId     String
  userId     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  correct    Int       @default(0)
  /// [{ correct, timeMs }] per question, in order.
  answers    Json      @default("[]")

  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([duelId, userId])
}
